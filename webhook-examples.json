      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "type": "ACCEPTED",
        "shareToken": "17175",
        "data": "10131796",
        "timeStatus": "2025-12-21T08:12:32.055Z"
      },
      "expected_response": {
        "error": 0,
        "errorMsg": "",
        "shareToken": "17175",
        "amount": 13990,
        "proofToken": "",
        "checkoutPayment": {
          "checkoutType": "CASH"
        }
      }
