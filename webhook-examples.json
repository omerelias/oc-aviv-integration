  "instructions": {
    "postman_setup": {
      "method": "POST",
      "url_template": "https://yoursite.com/wp-json/ocaviv/v1/getstatus",
      "headers": {
        "Content-Type": "application/json"
      },
      "body_type": "raw",
      "body_format": "JSON"
    },
    "how_to_use": [
      "1. פתח Postman",
      "2. בחר Method: POST",
      "3. הדבק את ה-URL (החלף yoursite.com בכתובת האתר שלך)",
      "4. הוסף Header: Content-Type: application/json",
      "5. בחר Body → raw → JSON",
      "6. העתק את ה-body מהדוגמה המתאימה",
      "7. החלף shareToken במספר הזמנה קיים",
      "8. החלף id ב-SKU או Product ID של מוצר קיים בהזמנה",
      "9. לחץ Send",
      "10. בדוק את התשובה ב-Postman ואת הלוג ב-WooCommerce → Aviv POS → לוג Webhook"
    ]
  }
}

